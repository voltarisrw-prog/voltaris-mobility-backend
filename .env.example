# Copy to .env for local development. NEVER commit a filled-in copy.
# In staging and production these come from managed secret storage, not a file.

ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=voltaris
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=5000

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Production refuses to start if this is short or still the placeholder.
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Google sign-in ---------------------------------------------------------
# Leave the client id blank to disable: the endpoints return NOT_CONFIGURED rather
# than pretending to work. Create credentials at console.cloud.google.com, add the
# redirect URI below to the authorised list, and keep the secret out of the repo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Object storage (Cloudflare R2) -----------------------------------------
# Blank account id disables uploads: the endpoints return NOT_CONFIGURED rather
# than presigning against a bucket that does not exist.
#
# R2 over S3 because egress is free. For an image-heavy marketplace served to
# Rwanda off a global CDN, egress is the line item that actually grows.
#
# R2_PUBLIC_BASE_URL must match `remotePatterns` in the frontend's
# next.config.mjs, or next/image refuses to load anything from it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voltaris-media
R2_PUBLIC_BASE_URL=https://media.voltaris.rw
R2_UPLOAD_TTL_SECONDS=900

# --- Session cookies --------------------------------------------------------
# "lax"  when the frontend and API share a registrable domain
#        (voltaris.rw + api.voltaris.rw are the same site)
# "none" when they do not — e.g. a *.vercel.app frontend calling a
#        *.onrender.com API. Lax cookies are NOT sent on cross-site fetch, so
#        login would appear to succeed and the next request would arrive
#        anonymous, with nothing in any log explaining it.
#
# "none" forces Secure, so it only works over HTTPS. The CSRF double-submit
# token carries the protection Lax was providing.
SESSION_COOKIE_SAMESITE=lax

# --- Payments ---------------------------------------------------------------
# 'stub' is refused in production — it can create sessions but never settle them.
PAYMENT_PROVIDER=stub
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=dev-insecure-change-me
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- Business ---------------------------------------------------------------
DEFAULT_CURRENCY=RWF
DEFAULT_COMMISSION_BPS=800       # 8.00%
PAYMENT_FEE_BPS=290              # 2.90%
PAYMENT_FEE_FIXED_MINOR=0

# --- Ops --------------------------------------------------------------------
# Must be the exact frontend origin. Cookie sessions require credentialed CORS,
# and a wildcard is both rejected by browsers for credentialed requests and by the
# production config guard.
CORS_ORIGINS=["http://localhost:3000"]
SENTRY_DSN=
MAX_REQUEST_BYTES=2097152

# --- Tests ------------------------------------------------------------------
# Set to run tests/integration against a real MongoDB (index + concurrency proofs).
MONGODB_TEST_URI=
